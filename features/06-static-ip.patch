From a3c64310d9a9097effbf90aa02fda77333a4b6e7 Mon Sep 17 00:00:00 2001
From: Jacob Buckles <buckles@blacksmith.sh>
Date: Sat, 18 Jul 2026 16:04:53 -0400
Subject: [PATCH] Run integration tests against the IP-allowlisted prod replica

Adds a scheduled workflow that exercises the integration suite against
the production replica. The replica sits behind a corporate IP
allowlist; CI reaches it via the org's Blacksmith static egress IP
(dedicated WireGuard tunnel to a NAT gateway with a fixed IP), so no
self-hosted runners or VPN sidecars are needed. Skips cleanly until the
REPLICA_DATABASE_URL secret is configured.
---
 template/.github/workflows/allowlisted-db.yml | 55 +++++++++++++++++++
 template/README.md                            | 10 ++++
 2 files changed, 65 insertions(+)
 create mode 100644 template/.github/workflows/allowlisted-db.yml

diff --git a/template/.github/workflows/allowlisted-db.yml b/template/.github/workflows/allowlisted-db.yml
new file mode 100644
index 0000000..fcb8df2
--- /dev/null
+++ b/template/.github/workflows/allowlisted-db.yml
@@ -0,0 +1,55 @@
+name: Prod-Replica Integration
+
+# Runs the integration suite against the production replica, which sits
+# behind a corporate IP allowlist. CI can only reach it because the
+# organization's Blacksmith runners egress through a static IP that the
+# DBA team added to the allowlist — no self-hosted runners, no VPN
+# sidecar, no credentials shared outside the database itself.
+#
+# Requires:
+#   - Blacksmith static IP enabled for the org (Settings -> Static IP),
+#     with that IP added to the replica's allowlist
+#   - REPLICA_DATABASE_URL repo/org secret
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: "17 6 * * 1-5"
+
+jobs:
+  replica-integration:
+    name: Integration vs allowlisted replica
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Check secret configuration
+        id: config
+        run: |
+          if [ -z "${{ secrets.REPLICA_DATABASE_URL }}" ]; then
+            echo "configured=false" >> "$GITHUB_OUTPUT"
+            echo "::notice::REPLICA_DATABASE_URL not configured; skipping replica tests."
+          else
+            echo "configured=true" >> "$GITHUB_OUTPUT"
+          fi
+
+      - uses: actions/setup-go@v5
+        if: steps.config.outputs.configured == 'true'
+        with:
+          go-version-file: backend/go.mod
+          cache: false
+
+      - name: Show egress IP
+        if: steps.config.outputs.configured == 'true'
+        run: |
+          echo "Egress IP for this job: $(curl -s https://api.ipify.org)"
+          echo "The replica's allowlist admits only the org's Blacksmith static IP."
+
+      - name: Integration tests against replica
+        if: steps.config.outputs.configured == 'true'
+        env:
+          DATABASE_URL: ${{ secrets.REPLICA_DATABASE_URL }}
+        run: go test -count=1 -tags integration ./internal/store/
diff --git a/template/README.md b/template/README.md
index 78d5a89..fdf595a 100644
--- a/template/README.md
+++ b/template/README.md
@@ -45,6 +45,16 @@ go test ./...
 DATABASE_URL=postgres://anvil:anvil@localhost:5432/anvil go test -tags integration ./internal/store/
 ```
 
+## Production replica access from CI
+
+The nightly `Prod-Replica Integration` workflow runs the integration
+suite against the production replica, which is IP-allowlisted. CI
+reaches it through the organization's Blacksmith static egress IP —
+runner traffic routes through a dedicated WireGuard tunnel to a NAT
+gateway with a fixed IP, which the DBA team allowlists once. Set the
+`REPLICA_DATABASE_URL` secret to enable it; the workflow skips cleanly
+when the secret is absent.
+
 ## Notes
 
 - `backend/internal/events/` is generated — edit `backend/tools/genevents`
