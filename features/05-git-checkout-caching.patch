From 581b3d22e089640fa1a96ee5f8e135cbc7cb1714 Mon Sep 17 00:00:00 2001
From: Jacob Buckles <buckles@blacksmith.sh>
Date: Sat, 18 Jul 2026 13:50:47 -0400
Subject: [PATCH] Cache git checkouts with Blacksmith
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Swap actions/checkout for useblacksmith/checkout — a drop-in replacement
(all inputs unchanged) that clones from a git mirror colocated with the
runner and kept warm across jobs. Cuts checkout time for this repo's
chunky history and vendored telemetry fixtures from tens of seconds to
~2s. Requires Blacksmith runners (see the runner migration PR).
---
 template/.github/workflows/ci.yml     | 6 +++---
 template/.github/workflows/docker.yml | 4 ++--
 template/.github/workflows/test.yml   | 4 ++--
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/template/.github/workflows/ci.yml b/template/.github/workflows/ci.yml
index 705234e..d9eebfd 100644
--- a/template/.github/workflows/ci.yml
+++ b/template/.github/workflows/ci.yml
@@ -23,7 +23,7 @@ jobs:
       run:
         working-directory: frontend
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - uses: actions/setup-node@v4
         with:
@@ -48,7 +48,7 @@ jobs:
       run:
         working-directory: backend
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - uses: actions/setup-go@v5
         with:
@@ -75,7 +75,7 @@ jobs:
       run:
         working-directory: backend
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - uses: actions/setup-go@v5
         with:
diff --git a/template/.github/workflows/docker.yml b/template/.github/workflows/docker.yml
index 0c9d54c..0c9dd92 100644
--- a/template/.github/workflows/docker.yml
+++ b/template/.github/workflows/docker.yml
@@ -15,7 +15,7 @@ jobs:
     name: Build backend image
     runs-on: ubuntu-latest
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - name: Log in to GHCR
         if: github.event_name != 'pull_request'
@@ -37,7 +37,7 @@ jobs:
     name: Build frontend image
     runs-on: ubuntu-latest
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - name: Log in to GHCR
         if: github.event_name != 'pull_request'
diff --git a/template/.github/workflows/test.yml b/template/.github/workflows/test.yml
index 38f3c6a..e0ae600 100644
--- a/template/.github/workflows/test.yml
+++ b/template/.github/workflows/test.yml
@@ -31,7 +31,7 @@ jobs:
       run:
         working-directory: backend
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - uses: actions/setup-go@v5
         with:
@@ -50,7 +50,7 @@ jobs:
       run:
         working-directory: frontend
     steps:
-      - uses: actions/checkout@v4
+      - uses: useblacksmith/checkout@v1
 
       - uses: actions/setup-node@v4
         with:
-- 
2.50.1 (Apple Git-155)

